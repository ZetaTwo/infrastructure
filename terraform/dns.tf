# Outbound email from mail.zeta-two.com via Postmark (docs/messaging.md).
# Postmark sends on its own IPs, so there's no A/MX record; SPF alignment
# comes from the Return-Path below, which points bounces at Postmark.
resource "cloudflare_dns_record" "mail_return_path" {
  zone_id = var.cloudflare_zones["zetatwo_com"]
  name    = "pm-bounces.mail"
  type    = "CNAME"
  content = "pm.mtasv.net"
  ttl     = 1
  proxied = false
}

# Monitor only (p=none) until Postmark's DMARC reports show everything
# passing, then tighten to quarantine.
resource "cloudflare_dns_record" "mail_dmarc" {
  zone_id = var.cloudflare_zones["zetatwo_com"]
  name    = "_dmarc.mail"
  type    = "TXT"
  content = "\"v=DMARC1; p=none; rua=mailto:calle.svensson@zeta-two.com\""
  ttl     = 1
}

