# Rendered by ansible/roles/canst for the {{ item.name }} environment. Mounted
# into the main canst-backend container and, in staging, the seed
# initContainer (ansible/roles/postgres's <db_name>_app role: DML only, no
# DDL) — see migrate.toml.j2 for the separate migrate initContainer's config.
[app]
paseto_key = "{{ item.paseto_key }}"
cookie_domain = "{{ item.domain }}"
public_url = "https://{{ item.domain }}"
listen_addr = "0.0.0.0:3000"
log_format = "json"

[database]
url = "postgres://{{ item.db_name }}_app:{{ item.app_db_password | urlencode }}@postgres.postgres.svc.cluster.local/{{ item.db_name }}"

[metrics]
# Prometheus metrics, scraped by vmsingle; the Deployment declares this port.
listen_addr = "0.0.0.0:9000"

# Operational messages to the operator via the cluster's Apprise API
# (ansible/roles/notify). Not a secret: the routing lives there.
[notify]
url = "http://notify.notify.svc.cluster.local:8000/notify/apps"
{% if item.postmark_token is defined %}

# Password reset emails through this environment's Postmark server (the
# server token is both username and password), from the zetatwo.dev apex
# (DNS in terraform/dns.tf). Without [smtp] they're only logged.
[smtp]
host = "smtp.postmarkapp.com"
port = 587
username = {{ item.postmark_token | to_json }}
password = {{ item.postmark_token | to_json }}
from = "Canst <canst@zetatwo.dev>"
{% endif %}
{% if item.seed | default(false) %}

# Lets the staging-only seed initContainer insert test data.
[seed]
enabled = true
{% endif %}

# The DESK's similar-prompt warning; the model is baked into the backend image
# (see the backend-deployment's memory limit).
[similarity]
model_dir = "/usr/local/share/canst/model"
